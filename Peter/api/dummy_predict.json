{
  "_meta": {
    "protocol": "POST /predict",
    "content_type": "application/json",
    "base_url_dev": "http://127.0.0.1:8000",
    "health": "GET /health → { \"ok\": true }",
    "source_features": "Aniket/FEATURE_SET.md",
    "notes": [
      "Request sends named features for the chosen speed. Server maps them into the per-target model vectors.",
      "Response is always the same shape regardless of speed.",
      "p_blunder is a probability in [0, 1].",
      "time_spent_* values are seconds (same units as FEATURE_SET target T).",
      "Swap this fixture for the live FastAPI response without changing field names."
    ]
  },

  "request_schema": {
    "speed": "bullet | blitz | classical",
    "features": "object whose keys are exactly the feature array for that speed in FEATURE_SET.md",
    "optional": {
      "game_id": "string, for logging / UI correlation",
      "ply": "also present inside features; may be duplicated at top level if useful"
    }
  },

  "response_schema": {
    "speed": "echo of request speed",
    "predictions": {
      "time_spent_s": "point estimate of think time (seconds)",
      "time_spent_p50_s": "optional median / typical think time",
      "time_spent_p75_s": "optional upper typical think time (nudge budget)",
      "p_blunder": "P(this move loses ≥ 20 win% points)"
    },
    "model": {
      "version": "string",
      "targets": ["time_spent", "blunder"]
    }
  },

  "examples": {
    "blitz_middlegame": {
      "request": {
        "speed": "blitz",
        "game_id": "dummy-blitz-001",
        "features": {
          "clock_self": 142.0,
          "clock_opp": 155.0,
          "clock_ratio": 0.916,
          "inc": 0,
          "prev_self_spent": 3.0,
          "avg_self_spent": 4.5,
          "prev_opp_spent": 2.0,
          "elo_self": 1510,
          "ply": 28,
          "mat_total": 62,
          "mat_diff": 0,
          "n_legal": 34,
          "n_captures": 5,
          "wp_self": 48.2,
          "abs_cp": 12,
          "last_swing": 8.5,
          "prior_blunders_self": 1
        }
      },
      "response": {
        "speed": "blitz",
        "game_id": "dummy-blitz-001",
        "predictions": {
          "time_spent_s": 5.4,
          "time_spent_p50_s": 4.0,
          "time_spent_p75_s": 7.0,
          "p_blunder": 0.12
        },
        "model": {
          "version": "dummy-v0",
          "targets": ["time_spent", "blunder"]
        }
      }
    },

