{
  "manifest_version": 3,
  "name": "Chess Coaching HUD",
  "version": "1.4.0",
  "description": "Live think-time / blunder-risk HUD for chess.com and Lichess via the OxTera predict API.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "shared/raw_game_state.js",
        "shared/clock_history.js",
        "shared/api.js",
        "shared/hud.js",
        "sites/chesscom.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://lichess.org/*"],
      "js": [
        "shared/raw_game_state.js",
        "shared/clock_history.js",
        "shared/api.js",
        "shared/hud.js",
        "sites/lichess.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://*:8000/*"
  ]
}
