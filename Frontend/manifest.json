{
  "manifest_version": 3,
  "name": "Chess Coaching HUD",
  "version": "1.0.0",
  "description": "Real-time behavioral metrics and coaching HUD integrated with Lichess and a custom Python backend.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}